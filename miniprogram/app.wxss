page {
  --green: #3ecf8e;
  --green-dark: #2dd4bf;
  --yellow: #fbbf24;
  --yellow-dark: #f59e0b;
  --bg: #f7f9fa;
  --card: #ffffff;
  --ink: #1a1a2e;
  --muted: #9ca3af;
  --rule: rgba(0, 0, 0, 0.06);
  --red: #ef4444;
  --blue: #2563eb;
  --safe-bottom: env(safe-area-inset-bottom);

  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.page-container {
  min-height: 100vh;
  padding: 0 28rpx 28rpx;
  box-sizing: border-box;
}

.page-container.has-tab {
  padding-bottom: calc(120rpx + var(--safe-bottom));
}

.page-container.has-fab {
  padding-bottom: calc(160rpx + var(--safe-bottom));
}

.card {
  background: var(--card);
  border-radius: 32rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-gradient {
  background: linear-gradient(135deg, var(--green) 0%, var(--green-dark) 100%);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  color: #fff;
  box-shadow: 0 8rpx 32rpx rgba(62, 207, 142, 0.25);
}

.card-yellow {
  background: linear-gradient(135deg, var(--yellow) 0%, var(--yellow-dark) 100%);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  color: #fff;
  box-shadow: 0 8rpx 32rpx rgba(251, 191, 36, 0.25);
}

.stat-label {
  font-size: 26rpx;
  opacity: 0.85;
  margin-bottom: 4rpx;
}

.hero-number {
  font-size: 64rpx;
  font-weight: 800;
  line-height: 1.1;
  margin: 8rpx 0;
}

.stat-value-sm {
  font-size: 32rpx;
  font-weight: 700;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--muted);
  margin: 28rpx 0 16rpx;
  letter-spacing: 0.04em;
}

.insight-card {
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-left: 6rpx solid var(--yellow-dark);
}

.insight-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #92400e;
  margin-bottom: 8rpx;
}

.insight-text {
  font-size: 26rpx;
  color: #78350f;
  line-height: 1.5;
}

.list-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--rule);
}

.list-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.list-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #e0f2fe, #dbeafe);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

.list-info {
  flex: 1;
  min-width: 0;
}

.list-title {
  font-size: 30rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-sub {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.list-right {
  text-align: right;
  flex-shrink: 0;
}

.list-price {
  font-size: 30rpx;
  font-weight: 700;
}

.list-arrow {
  font-size: 28rpx;
  color: #ccc;
  margin-left: 4rpx;
}

.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
  margin-right: 8rpx;
}

.tag-green { background: rgba(62, 207, 142, 0.12); color: #16a34a; }
.tag-orange { background: rgba(245, 158, 11, 0.12); color: #d97706; }
.tag-red { background: rgba(239, 68, 68, 0.1); color: #dc2626; }
.tag-blue { background: rgba(59, 130, 246, 0.1); color: var(--blue); }
.tag-gray { background: rgba(0, 0, 0, 0.06); color: var(--muted); }

.progress-bar {
  height: 10rpx;
  background: rgba(0, 0, 0, 0.08);
  border-radius: 6rpx;
  overflow: hidden;
  margin-top: 12rpx;
}

.progress-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, var(--green), var(--green-dark));
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 6rpx;
  display: flex;
  justify-content: space-between;
}

.divider {
  height: 1rpx;
  background: var(--rule);
  margin: 16rpx 0;
}

.fab {
  position: fixed;
  bottom: calc(140rpx + var(--safe-bottom));
  right: 28rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--green), var(--green-dark));
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 300;
  box-shadow: 0 8rpx 28rpx rgba(62, 207, 142, 0.35);
  z-index: 100;
  line-height: 1;
  padding: 0;
  margin: 0;
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, var(--green), var(--green-dark));
  color: #fff;
  border: none;
  border-radius: 24rpx;
  padding: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  width: 100%;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(62, 207, 142, 0.2);
  line-height: 1.4;
}

.btn-primary[disabled] {
  opacity: 0.4;
}

.btn-secondary {
  background: linear-gradient(135deg, var(--yellow-dark), var(--yellow));
  color: #fff;
  border: none;
  border-radius: 24rpx;
  padding: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  flex: 1;
  text-align: center;
  line-height: 1.4;
}

.btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.form-group {
  background: var(--card);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
}

.form-label {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
  display: block;
}

.form-input {
  width: 100%;
  font-size: 32rpx;
  font-weight: 600;
}

.form-hint {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 8rpx;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  font-weight: 400;
}

.mode-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.mode-tab {
  flex: 1;
  padding: 20rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  background: var(--card);
  color: var(--muted);
  border: 1rpx solid var(--rule);
}

.mode-tab.active {
  background: rgba(62, 207, 142, 0.12);
  color: #16a34a;
  border-color: var(--green);
}

.chart-area {
  background: var(--card);
  border-radius: 32rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.chart-bars {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  height: 160rpx;
  margin-top: 20rpx;
}

.chart-col {
  flex: 1;
  background: linear-gradient(180deg, var(--green), var(--green-dark));
  border-radius: 6rpx 6rpx 0 0;
  min-height: 8rpx;
  opacity: 0.7;
}

.chart-col.active {
  opacity: 1;
  box-shadow: 0 0 16rpx rgba(62, 207, 142, 0.3);
}

.chart-labels {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 8rpx;
}

.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.sheet {
  background: var(--bg);
  border-radius: 40rpx 40rpx 0 0;
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  padding: 40rpx 28rpx calc(40rpx + var(--safe-bottom));
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  background: #ddd;
  border-radius: 4rpx;
  margin: 0 auto 32rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 32rpx;
}

.empty-state {
  text-align: center;
  padding: 96rpx 48rpx;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: var(--muted);
  margin-bottom: 40rpx;
  line-height: 1.6;
}

.filter-row {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
  padding: 8rpx 0 24rpx;
  white-space: nowrap;
}

.filter-chip {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 600;
  background: var(--card);
  color: var(--muted);
  border: 1rpx solid var(--rule);
  display: inline-block;
}

.filter-chip.active {
  background: rgba(62, 207, 142, 0.12);
  color: #16a34a;
  border-color: var(--green);
}

.settings-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--rule);
}

.settings-item:last-child {
  border-bottom: none;
}

.settings-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.settings-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: rgba(62, 207, 142, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.settings-label {
  font-size: 30rpx;
  font-weight: 600;
}

.settings-desc {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.settings-arrow {
  color: #ccc;
  font-size: 30rpx;
}

.calc-result {
  text-align: center;
  padding: 40rpx;
}

.calc-number {
  font-size: 72rpx;
  font-weight: 800;
  color: var(--green);
}

.calc-verdict {
  display: inline-block;
  margin-top: 16rpx;
  padding: 12rpx 32rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.calc-verdict.buy {
  background: rgba(62, 207, 142, 0.15);
  color: #16a34a;
}

.calc-verdict.rent {
  background: rgba(59, 130, 246, 0.12);
  color: var(--blue);
}

.compare-row {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.compare-box {
  flex: 1;
  background: var(--card);
  border-radius: 24rpx;
  padding: 24rpx;
  text-align: center;
}

.compare-box.highlight {
  border: 4rpx solid var(--green);
}

.compare-label {
  font-size: 24rpx;
  color: var(--muted);
}

.compare-value {
  font-size: 32rpx;
  font-weight: 700;
  margin-top: 8rpx;
}

.sell-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--card);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.big-num {
  font-size: 56rpx;
  font-weight: 800;
}

.text-green { color: #10b981; }
.text-red { color: var(--red); }
.text-center { text-align: center; }

.detail-emoji { font-size: 80rpx; margin-bottom: 8rpx; }
.detail-name { font-size: 34rpx; font-weight: 700; }
.detail-meta { font-size: 24rpx; color: var(--muted); margin-top: 4rpx; }
.detail-tags { margin-top: 20rpx; }

.picker-value {
  font-size: 32rpx;
  font-weight: 600;
}

.muted-text {
  font-size: 24rpx;
  color: var(--muted);
}

.muted-text-center {
  font-size: 24rpx;
  color: var(--muted);
  text-align: center;
  margin-top: 16rpx;
}

.inline-btn {
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: inherit;
  font-size: inherit;
  color: inherit;
}

.inline-btn::after {
  border: none;
}
