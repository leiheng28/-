.detail-header {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 8rpx;
}

.menu-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: var(--card);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--muted);
}

.section-inline-title {
  font-size: 28rpx;
  font-weight: 600;
}

.target-daily {
  font-size: 24rpx;
  color: #f59e0b;
  font-weight: 600;
}

.kv-row {
  margin-bottom: 12rpx;
}

.kv-value {
  font-size: 28rpx;
  font-weight: 600;
}

.notes-text {
  font-size: 26rpx;
  color: var(--muted);
  margin-top: 8rpx;
  line-height: 1.5;
}

.btn-half {
  flex: 1;
  font-size: 28rpx;
  padding: 20rpx;
}
