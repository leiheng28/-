.profile-card {
  text-align: center;
  padding: 48rpx;
}

.profile-emoji {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
}

.profile-desc {
  font-size: 26rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}

.profile-meta {
  font-size: 24rpx;
  opacity: 0.7;
  margin-top: 16rpx;
}

.footer-note {
  font-size: 24rpx;
  color: var(--muted);
  text-align: center;
  margin-top: 48rpx;
  padding: 0 32rpx;
}
