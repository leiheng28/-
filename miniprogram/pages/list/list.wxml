<view class="page-container has-tab has-fab">
  <scroll-view scroll-x class="filter-row">
    <view
      wx:for="{{categories}}"
      wx:key="*this"
      class="filter-chip {{category === item ? 'active' : ''}}"
      data-value="{{item}}"
      bindtap="setCategory"
    >{{item}}</view>
  </scroll-view>

  <scroll-view scroll-x class="filter-row">
    <view
      wx:for="{{statusList}}"
      wx:key="*this"
      class="filter-chip {{status === item ? 'active' : ''}}"
      data-value="{{item}}"
      bindtap="setStatus"
    >{{item}}</view>
  </scroll-view>

  <block wx:if="{{filtered.length === 0}}">
    <view class="empty-state" style="padding: 64rpx 32rpx;">
      <view class="empty-icon">🔍</view>
      <view class="empty-title">暂无匹配资产</view>
      <view class="empty-desc">调整筛选条件或添加新资产</view>
    </view>
  </block>

  <block wx:else>
    <view class="card">
      <view
        wx:for="{{filtered}}"
        wx:key="id"
        class="list-item"
        data-id="{{item.id}}"
        bindtap="goDetail"
      >
        <view class="list-avatar">{{item.emoji}}</view>
        <view class="list-info">
          <view class="list-title">{{item.name}}</view>
          <view class="list-sub">
            {{item.category}} · 已用 {{item.days}} 天
            <text class="tag {{item.statusTag}}" style="margin-left: 12rpx;">{{item.status}}</text>
          </view>
        </view>
        <view class="list-right">
          <view class="list-price">{{item.daily}}<text class="list-arrow">›</text></view>
          <view class="list-sub">{{item.dailyLabel}}</view>
        </view>
      </view>
    </view>
  </block>

  <button class="fab" bindtap="goAdd">+</button>
</view>
