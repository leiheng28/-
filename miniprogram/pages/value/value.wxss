.card-head {
  padding: 32rpx 28rpx;
}

.head-emoji {
  font-size: 64rpx;
  margin-bottom: 8rpx;
}

.section-inline-title {
  font-size: 28rpx;
  font-weight: 600;
}

.tag-row {
  margin-top: 12rpx;
}

.tag-white {
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
}

.tag-row-desc {
  margin-top: 12rpx;
}

.kv-row {
  margin-bottom: 12rpx;
}

.kv-value {
  font-size: 28rpx;
  font-weight: 600;
}

.kv-value.green {
  color: var(--green);
}

.kv-value.blue {
  color: var(--blue);
}

.btn-half {
  flex: 1;
  font-size: 28rpx;
  padding: 20rpx;
}

.cancel-btn {
  width: 100%;
  margin-top: 16rpx;
  padding: 24rpx;
  color: var(--muted);
}
